{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "*.md"],
    "headers": [
      {
        "//": "El service worker nunca se cachea: si no, una versión vieja queda pegada.",
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "//": "El HTML se revalida siempre. Van las DOS rutas: la app abre en '/' y una regla solo para '/index.html' no la cubre.",
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "source": "/ex/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
